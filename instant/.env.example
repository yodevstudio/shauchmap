# ShauchMap Instant — environment template.
#
# Copy to `.env.local` (git-ignored) to enable FIREBASE MODE. With NO Firebase
# vars set, the app runs in FIXTURE MODE (deterministic local data, clearly
# marked "DEMO DATA", never production).
#
# FIREBASE MODE is what the live deployment runs in — point it at your own
# Firebase project, never at the YoDevStudio production one.
#
# A *production* build (`npm run build`) with VITE_DATA_MODE=firebase and any
# Firebase var missing will FAIL THE BUILD (fail-closed). It never silently
# falls back to fixtures.

# "fixture" (default) | "firebase"
VITE_DATA_MODE=fixture

# --- FIREBASE MODE (all required when VITE_DATA_MODE=firebase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Firestore database id — ShauchMap production is the default database.
VITE_FIREBASE_DATABASE_ID=(default)
# Optional: only if you use a non-default Firestore host / auth domain.
VITE_FIREBASE_AUTH_DOMAIN=
