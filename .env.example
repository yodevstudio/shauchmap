# ─────────────────────────────────────────────────────────────
# ShauchMap — environment template
# Copy to .env (never commit .env), then pass keys at build time:
#
#   flutter run  --dart-define=PLACES_API_KEY=$PLACES_API_KEY
#   flutter build apk --dart-define=PLACES_API_KEY=$PLACES_API_KEY
#
# For CI, set PLACES_API_KEY as a secret environment variable.
# ─────────────────────────────────────────────────────────────

# Google Places API key (HTTP / Web Services key).
# Create in Google Cloud Console → APIs & Services → Credentials.
# Restrict it to: Places API + Geocoding API, Android/iOS package name.
PLACES_API_KEY=AIzaSy_YOUR_PLACES_KEY_HERE

# ─────────────────────────────────────────────────────────────
# Keys you do NOT need to duplicate here (already handled):
#
#   Google Maps SDK key  → android/app/src/main/AndroidManifest.xml
#                          (android.maps key — restrict to package + SHA-1)
#
#   Firebase config      → android/app/google-services.json
#                          lib/firebase_options.dart
#                          (client-safe; protected by Firestore Security Rules
#                           + SHA-1 fingerprint + package restriction)
#
#   Release keystore     → android/key.properties  (git-ignored)
#                          android/loomap-release.jks (git-ignored)
# ─────────────────────────────────────────────────────────────
